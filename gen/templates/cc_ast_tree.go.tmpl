// Tree implementation
inline Tree::Tree(const std::string& path, const std::string& content)
    : path_(path), content_(content), lines_(LineOffsets(content)), root_(nullptr), nodes_() {}

inline std::pair<int, int> Tree::LineColumn(int64_t offset) const {
  const auto& lines = lines_;
  // Binary search to find the line number
  int left = 0;
  int right = static_cast<int>(lines.size()) - 1;
  int line = 0;
  while (left <= right) {
    int mid = (left + right) / 2;
    if (lines[mid] > offset) {
      right = mid - 1;
    } else {
      line = mid;
      left = mid + 1;
    }
  }
  return {line + 1, static_cast<int>(offset - lines[line] + 1)};
}

inline std::vector<int64_t> Tree::LineOffsets(const std::string& str) {
  std::vector<int64_t> lines = {0};  // Initialize with the starting offset (0)
  int64_t offset = 0;

  size_t i = str.find('\n', offset);
  while (i != std::string::npos) {
    lines.push_back(static_cast<int64_t>(i + 1));
    offset = static_cast<int64_t>(i + 1);
    i = str.find('\n', offset);
  }

  return lines;
}

// Node implementation
inline Node::Node(Tree* tree, {{template "nodeTypeRef" $}} type, int64_t offset, int64_t endoffset)
    : type_(type),
      offset_(offset),
      endoffset_(endoffset),
      parent_(nullptr),
      next_(nullptr),
      firstChild_(nullptr),
      tree_(tree) {}

